{
  "name": "uiforge-ai",
  "version": "1.0.0",
  "description": "An AI-Based Visual UI-to-Code Generation and Refinement System",
  "scripts": {
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "dev:backend": ".venv\\Scripts\\python.exe -m uvicorn app.main:app --app-dir backend --reload --port 8000",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": ".venv\\Scripts\\pytest.exe tests"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
